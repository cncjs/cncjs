-  uint8_t sreg = SREG;
-  cli();
-  sys_rt_exec_state |= (mask);
-  SREG = sreg;
+  // grbl-sim: atomic, interrupts run on another thread
+  __atomic_fetch_or(&sys_rt_exec_state, mask, __ATOMIC_SEQ_CST);
