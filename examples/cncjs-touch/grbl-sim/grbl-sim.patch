diff --git a/avr/interrupt.c b/avr/interrupt.c
index bf66458..24f1cd6 100644
--- a/avr/interrupt.c
+++ b/avr/interrupt.c
@@ -153,3 +153,77 @@ void timer_interrupts() {
 
 }
 
+
+
+// ---- event-driven helpers (added for grbl-sim on slow ARM boards) ----
+static enum sim_wgm_mode timer_mode(int i){
+  if (i==0 || i==2) { return sim_wgm_3[((io.tccrb[i]&0x08)>>1) | (io.tccra[i]&3)]; }
+  return sim_wgm_4[((io.tccrb[i]&0x18)>>1) | (io.tccra[i]&3)];
+}
+
+// Counter period: CTC counts 0..OCRA, the other supported modes 0..max.
+static uint32_t timer_period(int i){
+  uint32_t mask = timer_bitdepth[i];
+  if (timer_mode(i)==wgm_CTC) return (io.ocra[i]&mask)+1;
+  return mask+1;
+}
+
+// Increments from the current count until the counter equals value (never 0).
+static uint32_t increments_to(int i, uint32_t value){
+  uint32_t period = timer_period(i);
+  uint32_t cnt = io.tcnt[i] & timer_bitdepth[i];
+  if (value >= period) return 0;                 // never reached in this mode
+  uint32_t d = (value + period - (cnt % period)) % period;
+  return d ? d : period;
+}
+
+// CPU ticks until the next tick that can run one of Grbl's interrupt
+// routines (compare match with its interrupt enabled and a handler, or an
+// overflow/CTC top with an overflow handler). Capped at limit.
+uint32_t timer_ticks_to_next_event(uint32_t limit){
+  uint64_t best = limit;
+  int i;
+  for (i=0;i<SIM_N_TIMERS;i++){
+    int16_t inc = sim_scaling[io.tccrb[i]&7];
+    if (!inc) continue;                            // timer stopped
+    uint32_t mask = timer_bitdepth[i];
+    uint32_t first = inc - (io.prescaler % inc);   // ticks to the next increment
+    uint32_t d[4]; int n=0, k;
+    if (ovf_vect[i]) d[n++] = increments_to(i, timer_mode(i)==wgm_CTC ? (io.ocra[i]&mask) : 0);
+    if (compa_vect[i] && (io.timsk[i]&(1<<SIM_OCA))) d[n++] = increments_to(i, io.ocra[i]&mask);
+    if (compb_vect[i] && (io.timsk[i]&(1<<SIM_OCB))) d[n++] = increments_to(i, io.ocrb[i]&mask);
+    for (k=0;k<n;k++){
+      if (!d[k]) continue;
+      uint64_t ticks = (uint64_t)first + (uint64_t)(d[k]-1)*inc;
+      if (ticks < best) best = ticks;
+    }
+  }
+  return best ? (uint32_t)best : 1;
+}
+
+// Advance prescaler and counters by n CPU ticks inside which no interrupt can
+// run; flags set on the way are left as the per-tick code would leave them.
+void timer_skip(uint32_t n){
+  int i;
+  for (i=0;i<SIM_N_TIMERS;i++){
+    int16_t inc = sim_scaling[io.tccrb[i]&7];
+    if (!inc) continue;
+    uint32_t p = io.prescaler;
+    uint32_t increments = (uint32_t)((p + n) / inc - p / inc);
+    if (!increments) continue;
+    uint32_t mask = timer_bitdepth[i];
+    uint32_t period = timer_period(i);
+    uint32_t cnt = io.tcnt[i] & mask;
+    if (timer_mode(i)==wgm_CTC) {
+      uint32_t top = period-1;
+      // A pending rollover means the count is at TOP and wraps to 0 on the next increment.
+      uint32_t next = (cnt % period + increments) % period;
+      io.tifr[i] &= ~(1<<SIM_ROLL);
+      io.tcnt[i] = next;
+      if (next==top) io.tifr[i] |= (1<<SIM_TOV)|(1<<SIM_ROLL);
+    } else {
+      io.tcnt[i] = (cnt + increments) & mask;
+    }
+  }
+  io.prescaler += n;
+}
