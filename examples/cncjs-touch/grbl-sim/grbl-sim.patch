diff --git a/simulator.c b/simulator.c
index b863d13..2e2e042 100644
--- a/simulator.c
+++ b/simulator.c
@@ -1,3 +1,4 @@
+#include <stdlib.h>
 /*
   simulator.c - functions to simulate how the buffer is emptied and the
     stepper interrupt is called
@@ -79,6 +80,7 @@ void simulate_hardware(bool do_serial){
 }
 
 //runs the hardware simulator at the desired rate until sim.exit is set
+uint64_t dbg_loops=0, dbg_ticks=0, dbg_byte_limited=0, dbg_short=0, dbg_sreg_fixes=0;
 void sim_loop(){
   uint64_t simulated_ticks=0;
   uint32_t ns_prev = platform_ns();
@@ -100,6 +102,32 @@ void sim_loop(){
     
    while (sim.masterclock < simulated_ticks){
 
+    // Event-driven: skip the ticks on which nothing can happen (capped at 1 ms).
+    // GRBLSIM_NOSKIP=1 restores the original tick-by-tick loop for comparison.
+    static int noskip = -1;
+    if (noskip < 0) { noskip = getenv("GRBLSIM_NOSKIP") != NULL; }
+    if (!noskip) {
+      uint64_t room = simulated_ticks - sim.masterclock;
+      uint64_t to_byte = next_byte_tick > sim.masterclock ? next_byte_tick - sim.masterclock : 1;
+      uint32_t limit = F_CPU/1000;
+      if (room < limit) limit = (uint32_t)room;
+      if (to_byte < limit) limit = (uint32_t)to_byte;
+      uint32_t gap = timer_ticks_to_next_event(limit);
+      dbg_loops++; if (gap == limit && limit == (uint32_t)to_byte) dbg_byte_limited++; if (gap < 64) dbg_short++;
+      if (gap > 1) {
+        timer_skip(gap-1);
+        sim.masterclock += gap-1;
+      }
+    }
+
+    // Simulator artefact guard: interrupts left disabled for 5 ms are re-enabled.
+    {
+      static uint64_t cli_since = 0;
+      if (io.sreg & SEI) { cli_since = 0; }
+      else if (!cli_since) { cli_since = sim.masterclock ? sim.masterclock : 1; }
+      else if (sim.masterclock - cli_since > F_CPU/200) { io.sreg |= SEI; cli_since = 0; dbg_sreg_fixes++; }
+    }
+
     //only read serial port as fast as the baud rate allows
     bool read_serial = (sim.masterclock >= next_byte_tick);
 
@@ -115,12 +143,14 @@ void sim_loop(){
       if (UCSR0A & (1<<U2X0)) { sim.baud_ticks*=2; }
 
       next_byte_tick+=sim.baud_ticks;
+      // Idle line: poll again in 0.5 ms of simulated time rather than every byte slot.
+      { extern volatile uint8_t sim_serial_busy; if (!sim_serial_busy) next_byte_tick += F_CPU/2000; }
       // do app-specific per-byte processing
       sim_hook[sh_BYTE]();
     }
    }
 
-   platform_sleep(0); //yield
+   platform_sleep(1000); //yield (1 ms: keeps the CPU free on a small ARM board)
   }
 }
 
