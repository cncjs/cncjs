{
  "name": "cncjs",
  "version": "1.11.5",
  "description": "A web-based interface for CNC milling controller running Grbl, Marlin, Smoothieware, or TinyG",
  "homepage": "https://github.com/cncjs/cncjs",
  "author": "Cheton Wu <cheton@gmail.com>",
  "main": "./dist/cncjs/server-cli.js",
  "bin": {
    "cnc": "./bin/cnc",
    "cncjs": "./bin/cncjs"
  },
  "files": [
    "bin",
    "dist",
    "static"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:cncjs/cncjs.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "preferGlobal": true,
  "scripts": {
    "build": "yarn build-prod",
    "build-latest": "bash scripts/build-latest.sh",
    "build-dev": "bash scripts/build-dev.sh",
    "build-prod": "bash scripts/build-prod.sh",
    "clean": "del dist output",
    "electron": "electron",
    "electron-builder": "electron-builder",
    "electron-builder:debug": "cross-env DEBUG=electron-builder electron-builder",
    "electron-rebuild": "electron-rebuild",
    "github-release": "github-release",
    "package-sync": "node scripts/package-sync.js",
    "build:macos": "bash -c 'scripts/electron-builder.sh --macos --x64 --arm64'",
    "build:macos-x64": "bash -c 'scripts/electron-builder.sh --macos --x64'",
    "build:macos-arm64": "bash -c 'scripts/electron-builder.sh --macos --arm64'",
    "build:linux": "bash -c 'scripts/electron-builder.sh --linux --x64 --arm64 --armv7l'",
    "build:linux-x64": "bash -c 'scripts/electron-builder.sh --linux --x64'",
    "build:linux-armv7l": "bash -c 'scripts/electron-builder.sh --linux --armv7l'",
    "build:linux-arm64": "bash -c 'scripts/electron-builder.sh --linux --arm64'",
    "build:windows": "bash -c 'scripts/electron-builder.sh --windows --x64'",
    "build:windows-x64": "bash -c 'scripts/electron-builder.sh --windows --x64'",
    "start-electron": "electron ./dist/cncjs/main",
    "start-prod": "yarn build-prod && NODE_ENV=production ./bin/cncjs",
    "dev": "yarn run build-dev && concurrently --names \"start-app-dev,start-server-dev\" \"yarn run start-app-dev\" \"yarn run start-server-dev\"",
    "win-dev": "powershell -ExecutionPolicy Bypass -File scripts/build-dev.ps1 && concurrently --names \"start-app-dev,start-panel-dev,start-server-dev\" \"npm run start-app-dev\" \"npm run start-panel-dev\" \"npm run start-server-dev\"",
    "start-app-dev": "cross-env NODE_ENV=development webpack serve --progress --config webpack.config.development.js",
    "start-panel-dev": "cross-env NODE_ENV=development webpack --watch --config webpack.config.panel.development.js",
    "start-server-dev": "cross-env NODE_ENV=development ./bin/cncjs --port 8000 -m /widget:https://cncjs.github.io/cncjs-widget-boilerplate/v1/",
    "lint": "concurrently --kill-others-on-fail --names \"i18nlint,eslint,stylint,design\" \"yarn i18nlint\" \"yarn eslint\" \"yarn stylint\" \"yarn design-check\"",
    "design-check": "node scripts/check-design-tokens.js",
    "design-review": "node scripts/design-review.js",
    "design-diff": "node scripts/design-diff.js",
    "eslint": "eslint --color src scripts",
    "eslint-debug": "cross-env DEBUG=\"eslint:glob-util,eslint:config-*,eslint:cli*\" eslint --cache --color --quiet src scripts",
    "i18nlint": "bash -c 'find src/{app,server}/i18n -type f -name \"*.json\" | xargs -L1 -I{} -- bash -c \"echo Linting {}; jsonlint -q {}\"'",
    "stylint": "stylint src/app",
    "test": "jest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "ci-version": "changeset version && node scripts/package-sync.js && yarn install --mode=update-lockfile",
    "ci-publish": "yarn build && changeset publish"
  },
  "build": {
    "appId": "org.cncjs",
    "asar": false,
    "asarUnpack": [],
    "productName": "CNCjs",
    "directories": {
      "buildResources": "electron-build",
      "output": "output",
      "app": "dist/cncjs"
    },
    "publish": [],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "icon": "electron-build/icon.icns"
    },
    "dmg": {
      "background": "electron-build/background.png",
      "icon": "electron-build/icon.icns",
      "iconSize": 80,
      "iconTextSize": 12,
      "contents": [
        {
          "x": 448,
          "y": 344,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 192,
          "y": 344,
          "type": "file"
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "electron-build/icon.ico"
    },
    "linux": {
      "category": "Utility",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ]
    }
  },
  "keywords": [
    "cncjs",
    "arduino",
    "raspberry",
    "pi",
    "cnc",
    "gcode",
    "grbl",
    "smoothie",
    "smoothieware",
    "tinyg",
    "g2core",
    "react",
    "socket.io"
  ],
  "resolutions": {
    "lodash": "~4.18.1",
    "merge@^1.2.0": "~2.1.1",
    "mime@1.3.4": "~1.6.0",
    "morgan": "~1.10.0",
    "minimatch@3.0.4": "~3.1.5",
    "minimatch@^3.0.5": "~3.1.5",
    "minimatch@^3.1.2": "~3.1.5",
    "minimatch@2 || 3": "~3.1.5",
    "minimatch@^5.0.1": "~5.1.9",
    "ws@^8.18.0": "~8.21.3",
    "@trendmicro/react-dropdown@~1.3.0": "patch:@trendmicro/react-dropdown@npm%3A1.3.0#./.yarn/patches/@trendmicro-react-dropdown-npm-1.3.0-df4b1aed5a.patch",
    "@trendmicro/react-dropdown@^1.1.0": "patch:@trendmicro/react-dropdown@npm%3A1.3.0#./.yarn/patches/@trendmicro-react-dropdown-npm-1.3.0-df4b1aed5a.patch"
  },
