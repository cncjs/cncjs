  "jest": {
    "transform": {
      "^.+\\.js$": [
        "babel-jest",
        {
          "configFile": false,
          "presets": [
            [
              "@babel/preset-env",
              {
                "targets": {
                  "node": "current"
                }
              }
            ]
          ]
        }
      ]
    },
    "clearMocks": true,
    "collectCoverage": true,
    "collectCoverageFrom": [
      "<rootDir>/src/server/**/*.js",
      "!<rootDir>/src/server/**/*.test.js",
      "!<rootDir>/src/server/**/__tests__/**",
      "<rootDir>/src/app/widgets/Visualizer/toolpath-geometry.js",
      "<rootDir>/src/app/widgets/Visualizer/toolpath-segments.js",
      "<rootDir>/src/app/widgets/Visualizer/GCodeVisualizer.js",
      "<rootDir>/src/app/lib/controller/dispatch-event.js"
    ],
    "coverageReporters": [
      "lcov",
      "text",
      "html"
    ],
    "moduleDirectories": [
      "node_modules",
      "src"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/build"
    ],
    "setupFiles": [],
    "setupFilesAfterEnv": [
      "<rootDir>/jest-setup.js"
    ],
    "snapshotSerializers": [],
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/src/server/**/__tests__/**/*.test.js",
      "<rootDir>/grbl-simulator/__tests__/**/*.test.js",
      "<rootDir>/src/app/lib/controller/__tests__/**/*.test.js",
      "<rootDir>/src/app/features/**/__tests__/**/*.test.js",
      "<rootDir>/src/panel/**/__tests__/**/*.test.js",
      "<rootDir>/src/app/widgets/Visualizer/__tests__/**/*.test.js"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!three/)"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "testTimeout": 10000
  },
  "pre-push": [
    "eslint-debug"
  ],
  "collective": {
    "type": "opencollective",
    "url": "https://opencollective.com/cncjs"
  }
}
