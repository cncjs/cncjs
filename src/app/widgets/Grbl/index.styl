// What is left of this file is the widget's chrome and the controller dialog.
// Everything that drew a reading moved to `app/features/grbl`, where the look
// comes from the theme instead.

.widget-content {
    position: relative;
    padding: 10px;

    &.hidden {
        display: none;
    }
}

.nav-content {
    position: relative;
    overflow-y: auto;
    background: #000;
    color: #fff;
    border: 1px solid #ddd;

    .pre {
        display: block;
        font-family: Consolas, Menlo, Monaco, Lucida Console, Liberation Mono, DejaVu Sans Mono, Bitstream Vera Sans Mono, Courier New, monospace, serif;
        color: inherit;
        background: inherit;
        border: 0;
        border-radius: 0;
        margin: 0;
        padding: 10px;
    }
}
