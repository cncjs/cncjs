.keypad {
    overflow-x: auto;

    .keypad-controls {
        min-width: 280px;
    }

    button.btn-keypad {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 32px;
        font-size: 16px;
        padding: 0;
        width: 100%;
        line-height: 1;

        &:active,
        &.active {
            box-shadow: var(--tonic-shadows-low-main);
            transform: translate(1px, 1px);
        }

        :global {
            i.fa,
            span.fa {
                color: var(--tonic-colors-text-primary);
            }
        }

        &.highlight {
            background-color: var(--tonic-colors-actions-hovered);
            background-image: none;
            box-shadow: var(--tonic-shadows-low-main);
            border-color: var(--tonic-colors-border-secondary);

            &:hover,
            &.hover {
                background-color: var(--tonic-colors-actions-hovered);
            }

            &:active,
            &.active {
                box-shadow: var(--tonic-shadows-low-main);
                transform: translate(1px, 1px);
            }
        }
    }
    .col-space {
        width: 100%;
        min-width: 0;
    }
}
