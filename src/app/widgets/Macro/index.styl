.widget-content {
    position: relative;

    &.hidden {
        display: none;
    }
}

.table-container {
    min-height: 80px;
    max-height: 180px;
    overflow-x: auto;
    overflow-y: scroll;
}

.table {
    width: 100%;
    max-width: 100%;

    th {
        font-weight: normal;
    }

    > thead > tr > th,
    > tbody > tr > td,
    > tfoot > tr > td {
        padding: 4px 8px;
    }

    > thead > tr {
        background-color: var(--tonic-colors-background-high);
    }

    > thead > tr > th,
    > tbody > tr > td {
        border-top: 1px solid var(--tonic-colors-border-secondary);
        border-bottom: 1px solid var(--tonic-colors-border-secondary);

        &:first-child {
            border-left-width: 0;
        }
        &:last-child {
            border-right-width: 0;
        }
    }

    > thead > tr:first-child > th {
        border-top-width: 0;
    }

    > tbody > tr:first-child > td {
        border-top-width: 0;
    }
    > tbody > tr:nth-child(1n+3) > td {
        border-bottom-width: 0;
    }

    .empty-result {
        padding: 20px 30px;
        text-align: center;
    }
}

.table-bordered {
    border: 1px solid var(--tonic-colors-border-secondary);
}
