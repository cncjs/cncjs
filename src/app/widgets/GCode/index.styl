// What is left of this file is the widget chrome, not the widget.
//
// The G-code readings moved to `app/features/gcode`, which styles itself from
// the theme. These two rules belong to the bootstrap-era panel that still
// wraps it — the collapse toggle needs somewhere to hide the content without
// unmounting it, because unmounting would drop the module's subscriptions and
// lose the loaded job. Both rules go when the chrome does.

.widget-content {
    position: relative;

    &.hidden {
        display: none;
    }
}
