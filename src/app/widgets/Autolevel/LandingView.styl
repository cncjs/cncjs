// Landing View
.landing-view {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.path-card {
  border: 1px solid var(--color-border);
  padding: 15px;
  background-color: var(--color-surface-alt);

  &:hover {
    background-color: var(--color-surface-hover);
  }
}

.path-title {
  display: flex;
  align-items: center;
  column-gap: 4px;
  font-size: 14px;
  font-weight: 600;
  margin-bottom: 8px;
  color: var(--color-text-alt);
}

.path-description {
  font-size: 12px;
  color: var(--color-icon);
  margin-bottom: 12px;
  line-height: 1.4;
}

