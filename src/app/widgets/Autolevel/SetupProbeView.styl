// Setup Probe View
.setup-probe-view {
  padding: 5px 0;
}

.section-header {
  font-size: 14px;
  font-weight: 600;
  margin-bottom: 12px;
  padding-bottom: 8px;
  border-bottom: 2px solid var(--tonic-colors-border-secondary);
  color: var(--tonic-colors-text-primary);
}

.section {
  margin-bottom: 15px;
}

.section {
  &:last-child {
    margin-bottom: 0;
  }
}

.section-title {
  font-size: 14px;
  font-weight: 600;
  margin-bottom: 8px;
  color: var(--tonic-colors-text-secondary);
}

.scan-path-preview {
  display: flex;
  justify-content: space-between;
  margin-top: 8px;

  .glyph {
    flex: 1 1 0;
    min-width: 0;
    margin: 0 2px;
    padding: 2px 0;
    text-align: center;
  }

  .glyph-label {
    font-size: 10px;
    line-height: 1.2;
  }
}

