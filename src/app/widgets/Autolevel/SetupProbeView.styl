// Setup Probe View
.setup-probe-view {
  padding: 5px 0;
}

.section-header {
  font-size: 14px;
  font-weight: 600;
  margin-bottom: 12px;
  padding-bottom: 8px;
  border-bottom: 2px solid var(--tonic-colors-border-secondary);
  color: var(--tonic-colors-text-primary);
}

.section {
  margin-bottom: 15px;
}

.section {
  &:last-child {
    margin-bottom: 0;
  }
}

.section-title {
  font-size: 14px;
  font-weight: 600;
  margin-bottom: 8px;
  color: var(--tonic-colors-text-secondary);
}

