// Setup Probe View
.setup-probe-view {
  padding: 5px 0;
}

.section-header {
  font-size: 14px;
  font-weight: 600;
  margin-bottom: 12px;
  padding-bottom: 8px;
  border-bottom: 2px solid #e0e0e0;
  color: #333;
}

.section {
  margin-bottom: 15px;
}

.section {
  &:last-child {
    margin-bottom: 0;
  }
}

.section-title {
  font-size: 14px;
  font-weight: 600;
  margin-bottom: 8px;
  color: #555;
}

.scan-path-preview {
  display: flex;
  justify-content: space-between;

  .glyph {
    flex: 1 1 0;
    margin: 0 2px;
    padding: 2px 0;
    text-align: center;
    border: 1px solid transparent;
    border-radius: 3px;
    opacity: .45;
  }

  .glyph.selected {
    opacity: 1;
    border-color: #b8a070;
    background-color: #f5f0e0;
  }

  .glyph-label {
    font-size: 10px;
    line-height: 1.2;
    color: #666;
  }

  .glyph.selected .glyph-label {
    color: #333;
  }
}

// Form adjustments
.form-group {
  margin-bottom: 10px;

  label.control-label {
    font-size: 11px;
    margin-bottom: 4px;
  }

  small.text-muted {
    font-size: 10px;
    display: block;
    margin-top: 2px;
  }
}
