// Apply View
.section-header {
  font-size: 14px;
  font-weight: 600;
  margin-bottom: 15px;
  padding-bottom: 10px;
  border-bottom: 2px solid var(--tonic-colors-border-secondary);
  color: var(--tonic-colors-text-primary);
  letter-spacing: 0.3px;
}

.section {
  margin-bottom: 20px;

  :global(.form-group):last-child {
    margin-bottom: 0;
  }
}

.section:last-child {
  margin-bottom: 0;
}

.section-title {
  font-size: 14px;
  font-weight: 600;
  margin-bottom: 8px;
  color: var(--tonic-colors-text-secondary);
}

// Probe data info
.probe-data-info {
  padding: 12px;
  background-color: var(--tonic-colors-background-highest);
  border: 1px solid var(--tonic-colors-border-secondary);
  border-radius: 3px;
  font-size: 12px;
}

// G-code data info
.gcode-data-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8px 12px;
  background-color: var(--tonic-colors-info-_overlay);
  border: 1px solid var(--tonic-colors-border-secondary);
  border-radius: 3px;
  font-size: 12px;
  word-break: break-all;
}

.gcode-close-btn {
  background: none;
  border: none;
  padding: 0 0 0 8px;
  cursor: pointer;
  color: var(--tonic-colors-text-tertiary);
  flex-shrink: 0;

  &:hover {
    color: var(--tonic-colors-text-primary);
  }
}

.info-row {
  display: flex;
  column-gap: 4px;
  align-items: baseline;
  margin-bottom: 8px;
  line-height: 1.4;

  &:last-child {
    margin-bottom: 0;
  }
}

.info-label {
}

.info-value {
}

// Warning box (insufficient probe data)
.warning-box {
  font-size: 12px;
  color: var(--tonic-colors-warning-_onOverlay-text);
  padding: 12px;
  background-color: var(--tonic-colors-warning-_overlay);
  border: 1px solid var(--tonic-colors-border-secondary);
  border-radius: 3px;
  line-height: 1.5;
}

// Pipeline progress state
.pipeline-progress {
  padding: 16px 12px;
  background-color: var(--tonic-colors-info-_overlay);
  border: 1px solid var(--tonic-colors-border-secondary);
  border-radius: 3px;
  text-align: center;
}

.progress-text {
  font-size: 12px;
  color: var(--tonic-colors-info-icon);
  margin-bottom: 12px;
  font-weight: 500;
}

// Pipeline error state
.pipeline-error {
  display: flex;
  align-items: flex-start;
  padding: 14px 12px;
  background-color: var(--tonic-colors-error-_overlay);
  border: 1px solid var(--tonic-colors-border-secondary);
  border-radius: 3px;
  margin-bottom: 12px;
}

.error-icon {
  font-size: 16px;
  color: var(--tonic-colors-error-text);
  margin-right: 12px;
  flex-shrink: 0;
  margin-top: 2px;
}

.error-text {
  flex: 1;
  min-width: 0;
}

.error-file-name {
  font-size: 11px;
  font-weight: 600;
  color: var(--tonic-colors-error-text);
}

.error-detail {
  font-size: 10px;
  color: var(--tonic-colors-text-tertiary);
  margin-top: 4px;
  word-break: break-word;
  line-height: 1.4;
}


.no-data {
  text-align: center;
  padding: 24px 16px;
  color: var(--tonic-colors-text-disabled);
  font-style: italic;
  font-size: 11px;
}
