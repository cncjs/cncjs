.tree-node {
    cursor: default;

    .selected&,
    .selected&:hover {
        background: var(--tonic-colors-actions-selected);
    }

    &:hover {
        background: var(--tonic-colors-actions-hovered);
    }
    &:disabled,
    &[disabled] {
        cursor: not-allowed;
        opacity: .5;
    }
}

.tree-node-column {
    padding: 2px 4px;
    user-select: none;

    &.no-padding {
        padding: 0;
    }
}

.tree-toggler {
    display: inline-block;
    width: 18px;
    text-align: center;
    cursor: pointer;
    color: var(--tonic-colors-text-secondary);
    margin-left: -2px;
    margin-right: 2px;

    &:hover {
        color: var(--tonic-colors-text-primary);
        text-decoration: none;
    }
}

.no-data {
    text-align: center;
}
