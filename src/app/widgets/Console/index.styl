.widget-content {
    position: relative;

    &.hidden {
        display: none;
    }

    &.fullscreen {
        .terminal-container {
            height: 100%;
        }

        // With the command input shown, the terminal takes the height that is left
        .console {
            display: flex;
            flex-direction: column;
            height: 100%;

            .terminal-container {
                flex: 1 1 auto;
                height: auto;
                min-height: 0;
            }
        }
    }
}

.command-input {
    display: flex;
    padding: 8px;

    input {
        flex: 1 1 auto;
        min-width: 0;
    }

    button {
        margin-left: 8px;
    }
}

.no-serial-connection {
    padding: 10px;
    color: var(--color-text-alt);
    opacity: .65;
}

.terminal-container {
    background: #000;
    overflow-x: auto;
    overflow-y: hidden;
}

.icon {
    display: inline-block;
    width: 14px;
    height: 14px;
    vertical-align: middle;
    margin: 0 2px 2px 2px;

    &.select-all {
        background: url("./images/select-all.svg") no-repeat 0 0;
    }
}

.terminal-container {
    border-top: 5px solid;
    border-left: 5px solid;
    border-right: 5px solid;
    padding-bottom: 5px;

    // Offset the xterm screen as a layout box, not just with a transform on the canvases: xterm takes
    // mouse coordinates from the screen element's box, so it must move with what is drawn
    :global(.xterm-screen) {
        position: relative;
        left: 5px;
        top: 5px;
    }

    :global(.ps--scrolling-y) > :global(.ps__rail-y) {
        opacity: .9;
    }

    &::-webkit-scrollbar { height: 15px }
    &::-webkit-scrollbar-track { background-color: var(--terminal-bg) }
    &::-webkit-scrollbar-thumb {
        background-color: var(--terminal-thumb);
        border-radius: 8px;
        border: 3px solid var(--terminal-bg);
    }
}
