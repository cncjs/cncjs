.widget-content {
    position: relative;

    &.hidden {
        display: none;
    }

    &.fullscreen {
        .console {
            height: 100%;
        }

        .terminal-container {
            flex: 1;
            min-height: 0;
        }
    }
}

.no-serial-connection {
    padding: 8px 12px;
    color: var(--tonic-colors-text-primary);
    opacity: .65;
}

.terminal-container {
    background: var(--tonic-colors-background-_fixed-dark-low);
    overflow-x: auto;
    overflow-y: hidden;
}

.terminal-container {
    :global {
        .ps__rail-y {
            background-color: var(--terminal-bg);
        }
        .ps__thumb-y {
            background-color: var(--terminal-thumb);
        }
    }
}

.console {
    display: flex;
    flex-direction: column;
}
