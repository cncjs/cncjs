// @stylint off
//
// Theme tokens. Every themed color is a CSS custom property defined once per theme:
// :root/.theme-light holds the original (light) values, .theme-dark the dark values.
// The class is toggled on <html> by src/app/lib/theme.js. To theme a new surface, add a
// token to both blocks and use var(--your-token) in the stylesheet or inline style.

@css {
  :root,
  .theme-light {
    color-scheme: light;
    --color-sidebar-bg: #222;
    --color-content-bg: #fff;
    --color-surface: #fff;
    --color-surface-alt: rgb(249, 249, 249);
    --color-surface-hover: rgb(245, 245, 245);
    --color-surface-active: rgb(238, 238, 238);
    --color-border: rgb(221, 221, 221);
    --color-border-subtle: rgb(238, 238, 238);
    --color-border-strong: rgb(204, 204, 204);
    --color-border-stronger: rgb(187, 187, 187);
    --color-text-muted: rgb(153, 153, 153);
    --color-icon: rgb(102, 102, 102);
    --color-link: #4078c0;
    --btn-default-top: rgb(251, 251, 251);
    --btn-default-bottom: rgb(236, 236, 236);
    --btn-default-hover-top: rgb(255, 255, 255);
    --btn-default-hover-bottom: rgb(245, 245, 245);
    --color-text: rgb(34, 34, 34);
    --color-text-secondary: rgb(68, 68, 68);
    --color-text-subtle: rgb(136, 136, 136);
    --color-text-disabled: rgb(230, 230, 230);
    --color-placeholder: rgb(187, 187, 187);
    --color-input-disabled-bg: rgb(221, 221, 221);
    --color-mark-bg: rgb(253, 240, 195);
    --color-selection-bg: #b3d4fc;
    --color-sidebar-border: #333;
    --color-sidebar-active-bg: #080808;
    --color-panel-bg: #f6f7f8;
    --color-widget-header-bg: #f6f7f8;
    --color-widget-footer-bg: #fafafa;
    --color-widget-icon: #838383;
    --color-widget-icon-hover: #505050;
    --color-divider-subtle: rgba(0, 0, 0, .09);
    --color-hover-overlay: rgba(0, 0, 0, .05);
    --color-dropzone-bg: rgba(255, 255, 255, .5);
    --color-nav-bg: #f5f5f5;
    --color-nav-text: #000;
    --color-nav-hover-text: #cc0000;
    --color-nav-active-bg: #999;
    --color-border-light: #e0e0e0;
    --color-border-faint: #e3e3e3;
    --color-surface-faint: #fafafa;
    --color-text-alt: #333;
    --color-text-mid: #555;
    --color-text-dim: #aaa;
    --color-info-bg: #f0f7ff;
    --color-info-border: #c4ddf6;
    --color-info-bg-soft: #f7fbff;
    --color-info-border-soft: #e3f0ff;
    --color-info-track: #d4e5f7;
    --color-warning-bg: #fff9e6;
    --color-warning-border: #ffeaa7;
    --color-warning-text: #856404;
    --color-danger-bg: #fff5f5;
    --color-danger-border: #ffe0e0;
    --color-action-hover-bg: #e6e6e6;
    --color-keypad-highlight-bg: rgba(240, 240, 240, .8);
    --color-keypad-highlight-border: rgba(0, 0, 0, .4);
    --color-hover-overlay-strong: rgba(0, 0, 0, .1);
    --color-error-text: #a94442;
    --color-thumb-bg: #f5f6f7;
    --color-thumb-icon: rgba(64, 64, 64, .8);
    --color-thumb-icon-off: #ccc;
    --color-thumb-shadow: #a0a0a0;
    --color-text-off: #ccc;
    --color-border-mid: #aaa;
    --color-text-hint: #767676;
    --color-rule: #e6e6e6;
    --color-icon-active: #000;
    --color-well-bg: #f5f5f5;
    --color-overlay-bg: rgba(255, 255, 255, .7);
    --color-overlay-bg-strong: rgba(255, 255, 255, .9);
    --toolbar-filter: invert(40%);
    --toolbar-filter-hover: invert(0%);
    --toolbar-filter-highlight: invert(100%);
    --toolbar-img-filter: none;
    --toolbar-img-filter-hover: none;
    --toolbar-img-filter-highlight: none;
    --toolbar-highlight-bg: rgba(255, 255, 255, .7);
  }

  .theme-dark {
    color-scheme: dark;
    --color-sidebar-bg: #111;
    --color-content-bg: #1e1e1e;
    --color-surface: #252526;
    --color-surface-alt: #2a2a2b;
    --color-surface-hover: #323233;
    --color-surface-active: #3a3a3b;
    --color-border: #3c3c3c;
    --color-border-subtle: #333;
    --color-border-strong: #4a4a4a;
    --color-border-stronger: #5a5a5a;
    --color-text-muted: #9a9a9a;
    --color-icon: #a0a0a0;
    --color-link: #6ea8f0;
    --btn-default-top: #3a3a3a;
    --btn-default-bottom: #2f2f2f;
    --btn-default-hover-top: #444;
    --btn-default-hover-bottom: #383838;
    --color-text: #e4e4e4;
    --color-text-secondary: #bdbdbd;
    --color-text-subtle: #8c8c8c;
    --color-text-disabled: #5c5c5c;
    --color-placeholder: #777;
    --color-input-disabled-bg: #2e2e2e;
    --color-mark-bg: #5a4a10;
    --color-selection-bg: #264f78;
    --color-sidebar-border: #222;
    --color-sidebar-active-bg: #000;
    --color-panel-bg: #181818;
    --color-widget-header-bg: #2d2d2e;
    --color-widget-footer-bg: #2a2a2b;
    --color-widget-icon: #9a9a9a;
    --color-widget-icon-hover: #e0e0e0;
    --color-divider-subtle: rgba(255, 255, 255, .12);
    --color-hover-overlay: rgba(255, 255, 255, .08);
    --color-dropzone-bg: rgba(0, 0, 0, .5);
    --color-nav-bg: #202021;
    --color-nav-text: #e4e4e4;
    --color-nav-hover-text: #ff7b7b;
    --color-nav-active-bg: #4a4a4a;
    --color-border-light: #3a3a3a;
    --color-border-faint: #353535;
    --color-surface-faint: #2a2a2b;
    --color-text-alt: #d4d4d4;
    --color-text-mid: #b0b0b0;
    --color-text-dim: #7a7a7a;
    --color-info-bg: #14263a;
    --color-info-border: #2d4a6b;
    --color-info-bg-soft: #112031;
    --color-info-border-soft: #243b57;
    --color-info-track: #2d4a6b;
    --color-warning-bg: #3a3010;
    --color-warning-border: #6b5a1e;
    --color-warning-text: #e6c35c;
    --color-danger-bg: #3a1a1a;
    --color-danger-border: #6b2c2c;
    --color-action-hover-bg: #3a3a3b;
    --color-keypad-highlight-bg: rgba(70, 70, 72, .8);
    --color-keypad-highlight-border: rgba(255, 255, 255, .35);
    --color-hover-overlay-strong: rgba(255, 255, 255, .14);
    --color-error-text: #e57373;
    --color-thumb-bg: #1b1b1c;
    --color-thumb-icon: rgba(210, 210, 210, .85);
    --color-thumb-icon-off: #4a4a4a;
    --color-thumb-shadow: #000;
    --color-text-off: #666;
    --color-border-mid: #666;
    --color-text-hint: #8f8f8f;
    --color-rule: #3a3a3a;
    --color-icon-active: #f0f0f0;
    --color-well-bg: #1f1f20;
    --color-overlay-bg-strong: rgba(37, 37, 38, .92);
    --toolbar-filter: none;
    --toolbar-filter-hover: none;
    --toolbar-filter-highlight: none;
    --toolbar-img-filter-hover: invert(100%);
    --toolbar-img-filter-highlight: invert(0%);
    --toolbar-highlight-bg: rgba(255, 255, 255, .9);
  }
}