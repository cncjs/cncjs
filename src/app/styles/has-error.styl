.has-error {
    color: var(--color-error-text);

    .form-control {
        border-color: var(--color-error-text);
        box-shadow: inset 0 1px 1px rgba(0, 0, 0, .075);
    }
    .form-control:focus {
        border-color: #843534;
        box-shadow: inset 0 1px 1px rgba(0, 0, 0, .075), 0 0 6px #ce8483;
    }
}
