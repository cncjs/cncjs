@import '../../styles/variables';
@import './theme';

.widget {
    &.widget-borderless {
        .widget-header,
        .widget-content,
        .widget-footer {
            border: 0;
        }
        .widget-header + .widget-content,
        .widget-header + .widget-footer,
        .widget-content + .widget-footer {
            border-top: 1px solid var(--tonic-colors-border-secondary);
        }
    }

    &.widget-fullscreen {
        position: fixed;
        top: $navbar-height; // navbar
        left: $sidebar-width; // sidebar
        right: 0;
        bottom: 0;
        margin: 0;
        z-index: 1000;
        display: flex;
        flex-direction: column;
        background-color: var(--tonic-colors-background-high);
        color: var(--tonic-colors-text-primary);

        .widget-sortable {
            display: none;
        }
    }
    &.widget-fullscreen {
        .widget-header,
        .widget-footer {
            flex: none;
        }
        .widget-content {
            position: relative;
            flex: 1 1 0;
            min-height: 0;
            overflow: auto;
        }
    }

    .widget-header {
        position: relative;
        display: flex;
        align-items: stretch;
    }
    .widget-header-fixed {
        cursor: default;
    }

    .widget-sortable {
        display: inline-block;
        cursor: move;

        > a {
            cursor: move;
        }
    }

    .widget-title {
        flex: 1 1 auto;
        min-width: 0;
        font-weight: 400;
        display: inline-block;
        margin-top: 0;
        margin-bottom: 0;
        line-height: 1.5;
        font-size: 1rem;
        padding: .375rem .75rem;

        // Truncate string with ellipsis
        text-overflow: ellipsis;
        overflow: hidden;
        white-space: nowrap;
        width: auto;
        max-width: 100%;
    }

    .widget-content,
    .widget-footer {
        border: 1px solid var(--tonic-colors-border-secondary);
        border-top: none;
    }

    .widget-button {
        text-decoration: none;
        font-size: 1rem;
        text-align: center;
        display: inline-block;
        line-height: calc(.5rem + 1rem + .5rem);
        padding: 0;
        margin: 0;
    }

    .widget-controls {
        display: flex;
        align-items: stretch;
        flex: 0 0 auto;
        margin-left: auto;
        cursor: auto;
        width: auto;

        .widget-button {
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 auto;
            float: none;
            align-self: stretch;
            min-width: 36px;
            padding: 2px 8px;
            position: relative;
            font-size: 1rem;
            font-family: Arial, Helvetica, sans-serif;
            border-left: 1px solid var(--tonic-colors-border-secondary);
            margin: 0;
            text-align: center;

            &:hover {
                background-color: var(--tonic-colors-actions-hovered);
            }

        }
    }
}
