# Set the default behavior
* text=auto

# Git will always convert line endings to LF on checkout. You should use this for files that must keep LF endings, even on Windows.
*.css text eol=lf
*.js  text eol=lf
*.jsx text eol=lf
*.sh  text eol=lf

# A yarn patch is applied verbatim against the package's own files, which are
# LF. Checked out with CRLF it stops matching and the install fails.
*.patch text eol=lf
